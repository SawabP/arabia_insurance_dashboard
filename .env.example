# AIVA Dashboard - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection for AIVA dashboard
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=aiva
DB_USER=arabia_insurance
DB_PASSWORD=aivaa@edata.ae

# Full Database URL (alternative format)
# DATABASE_URL=postgresql://arabia_insurance:aivaa%40edata.ae@127.0.0.1:5433/aiva

# ============================================
# OPENAI CONFIGURATION
# ============================================
# Required for AI conversation analysis feature
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenAI Organization ID (if applicable)
# OPENAI_ORG_ID=your_org_id

# ============================================
# NEXT.JS CONFIGURATION
# ============================================
# Node environment
NODE_ENV=development

# Optional: Custom Next.js port
# PORT=3000

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Optional: Enable/disable mock data fallback
# USE_MOCK_DATA=false
